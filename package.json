{
  "name": "countrystatecity-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "test": "node --test $(find scripts -name '*.test.cjs') && turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "fetch-database": "node scripts/fetch-database.cjs",
    "fetch-postcodes": "node scripts/fetch-postcodes.cjs",
    "generate-data": "node scripts/generate-all.cjs",
    "update-data": "pnpm fetch-database && pnpm generate-data && pnpm build",
    "update-postcodes": "pnpm fetch-postcodes && pnpm --filter @countrystatecity/postalcodes generate-data ../../data/postcodes-source.json && pnpm --filter @countrystatecity/postalcodes build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "tsup": "^8.5.1",
    "vite": "^8.3.5",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.16.1"
}
