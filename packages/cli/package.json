{
  "name": "@countrystatecity/cli",
  "version": "0.2.0",
  "description": "Official CLI for the Country State City API - search, explore, and generate code from geographic data",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "csc": "./dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "country",
    "state",
    "city",
    "geography",
    "cli",
    "country-state-city",
    "geolocation",
    "iso",
    "dropdown",
    "seed",
    "code-generator"
  ],
  "author": "dr5hn",
  "license": "MIT",
  "homepage": "https://github.com/dr5hn/countrystatecity-npm/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/dr5hn/countrystatecity-npm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr5hn/countrystatecity-npm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@countrystatecity/sdk": "workspace:*",
    "@inquirer/search": "^3.2.2",
    "@inquirer/select": "^4.4.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "open": "^10.2.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "~4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
